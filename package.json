{
  "name": "jsonlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "description": "JSONLens - Semantic JSON Diff, Beautifier, Formatter, Validator & Type Generator",
  "author": {
    "name": "Rajesh Narwal",
    "email": "rajesh@grassroot.digital",
    "url": "https://grassroot.digital"
  },
  "homepage": "https://jsonlens.grassroot.digital",
  "build": {
    "appId": "digital.grassroot.jsonlens",
    "productName": "JSONLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "electron/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "electron/icon.png",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Development",
      "maintainer": "Rajesh Narwal <rajesh@grassroot.digital>",
      "target": ["AppImage", "deb"]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
